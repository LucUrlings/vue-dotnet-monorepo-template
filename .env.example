# Copy this file to .env before a server deployment.
COMPOSE_PROJECT_NAME=vue-dotnet-monorepo
DEV_COMPOSE_PROJECT_NAME=vue-dotnet-monorepo-dev
FRONTEND_PORT=8080
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Production

# Replace these after creating a repository from this template.
FRONTEND_IMAGE=ghcr.io/lucurlings/vue-dotnet-monorepo-template-frontend
BACKEND_IMAGE=ghcr.io/lucurlings/vue-dotnet-monorepo-template-backend
IMAGE_TAG=latest
